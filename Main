-- Main Script Precision | Breakout (Sentenced)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
while not player do task.wait() player = Players.LocalPlayer end
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

FOV_RADIUS = 100
SMOOTHNESS = 0.80
SPINBOT_SPEED = 0
AIM_ANGLE_OFFSET = 10.5
AIMBOT_ENABLED = true
HIDE_TAG_ENABLED = false
WANTED_ONLY = false
IGNORE_FRIENDS = true
ESP_ENABLED = false
ESP_NAMES_ENABLED = true  
local MOUSE_LOCKED = false
HIDE_FOV_CIRCLE = false
IGNORE_INMATES = false
IGNORE_GUARDS = false
IGNORE_CRIMINALS = false
IGNORE_FORCEFIELD = true
IGNORE_WARDEN = false
local PC_TARGET = nil
local target = nil
local currentSkybox = nil
TARGET_ON_PLAYER = nil

local isMobile = game:GetService("UserInputService").TouchEnabled
if not isMobile then AIM_ANGLE_OFFSET = 0 end

loadstring(game:HttpGet("https://raw.githubusercontent.com/maplez211/sentenced-breakout/refs/heads/main/UI"))()

-- ============ FOV CIRCLE ============
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FOVGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local fovCircle = Instance.new("Frame", screenGui)
fovCircle.Size = UDim2.new(0, FOV_RADIUS*2, 0, FOV_RADIUS*2)
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.BackgroundColor3 = Color3.fromRGB(0,0,0)
fovCircle.BackgroundTransparency = 1
fovCircle.BorderSizePixel = 0
Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(1,0)
Instance.new("UIStroke", fovCircle).Color = Color3.fromRGB(0, 0, 0)
fovCircle.UIStroke.Thickness = 1
fovCircle.Visible = AIMBOT_ENABLED
_G.fovCircle = fovCircle

_G.toggleFOVCircle = function(hide)
    local stroke = fovCircle:FindFirstChild("UIStroke")
    if stroke then
        stroke.Enabled = not hide
    end
end

-- ============ MAIN FUNCTIONS ============
local function isVisible(targetCharacter)
	if not targetCharacter then return false end
	local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end
	local origin = camera.CFrame.Position
	local direction = hrp.Position - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {player.Character, targetCharacter}
	return Workspace:Raycast(origin, direction, params) == nil
end

-- ============ AIMBOT SYSTEM ============
local function getClosestMobile()
    if TARGET_ON_PLAYER then
        local targetPlr = Players:FindFirstChild(TARGET_ON_PLAYER)
        if targetPlr and targetPlr.Character then
            local humanoid = targetPlr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = targetPlr.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and hrp then
                if IGNORE_FORCEFIELD then
                    local ff = targetPlr.Character:FindFirstChildOfClass("ForceField")
                    if ff and ff.Visible then return nil end
                end
                if WANTED_ONLY and targetPlr.Team and targetPlr.Team.Name == "Inmates" then
                    local head = targetPlr.Character:FindFirstChild("Head")
                    if head then
                        local bb = head:FindFirstChild("OverheadBBGUI")
                        local wanted = bb and bb:FindFirstChild("WantedTag")
                        if not wanted or not wanted.Visible then return nil end
                    end
                end
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen and isVisible(targetPlr.Character) then return targetPlr end
            end
        end
        return nil
    end

    local closest = nil
    local shortestDistance = math.huge
    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local myTeam = player.Team
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            if IGNORE_FRIENDS and player:IsFriendsWith(plr.UserId) then continue end
            if myTeam and plr.Team == myTeam then continue end
            if plr.Team then
                local tn = plr.Team.Name
                if IGNORE_INMATES and tn == "Inmates" then continue end
                if IGNORE_GUARDS and tn == "Guards" then continue end
                if IGNORE_CRIMINALS and tn == "Criminals" then continue end
                if IGNORE_WARDEN and tn == "Warden" then continue end
            end
            if IGNORE_FORCEFIELD then
                local ff = plr.Character:FindFirstChildOfClass("ForceField")
                if ff and ff.Visible then continue end
            end
            if WANTED_ONLY and plr.Team and plr.Team.Name == "Inmates" then
                local head = plr.Character:FindFirstChild("Head")
                if head then
                    local bb = head:FindFirstChild("OverheadBBGUI")
                    local wanted = bb and bb:FindFirstChild("WantedTag")
                    if not wanted or not wanted.Visible then continue end
                end
            end
            
            local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and hrp then
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if dist < FOV_RADIUS and dist < shortestDistance then
                        if isVisible(plr.Character) then
                            closest = plr
                            shortestDistance = dist
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function getClosestTargetPC()
    local mousePos = UserInputService:GetMouseLocation()
    local best = nil
    local bestDist = FOV_RADIUS
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player or not plr.Character then continue end
        if IGNORE_FRIENDS and player:IsFriendsWith(plr.UserId) then continue end
        if IGNORE_FORCEFIELD then
            local ff = plr.Character:FindFirstChildOfClass("ForceField")
            if ff and ff.Visible then continue end
        end
        if plr.Team then
            local tn = plr.Team.Name
            if IGNORE_INMATES and tn == "Inmates" then continue end
            if IGNORE_GUARDS and tn == "Guards" then continue end
            if IGNORE_CRIMINALS and tn == "Criminals" then continue end
            if IGNORE_WARDEN and tn == "Warden" then continue end
        end
        if WANTED_ONLY and plr.Team and plr.Team.Name == "Inmates" then
            local head = plr.Character:FindFirstChild("Head")
            if head then
                local bb = head:FindFirstChild("OverheadBBGUI")
                local wanted = bb and bb:FindFirstChild("WantedTag")
                if not wanted or not wanted.Visible then continue end
            end
        end
        
        local aimPart = plr.Character:FindFirstChild("HumanoidRootPart") or plr.Character:FindFirstChild("Torso")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if aimPart and hum and hum.Health > 0 then
            local pos, onScreen = camera:WorldToViewportPoint(aimPart.Position)
            if onScreen and isVisible(plr.Character) then
                local dist = (Vector2.new(pos.X, pos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
                if dist < bestDist then
                    best = plr
                    bestDist = dist
                end
            end
        end
    end
    return best
end

local function updateFOVPosition()
    if not fovCircle then return end
    if isMobile then
        fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
        fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
    else
        fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = UDim2.new(0, mousePos.X - FOV_RADIUS, 0, mousePos.Y - FOV_RADIUS - 36)
    end
end

RunService.RenderStepped:Connect(function()
    updateFOVPosition()
    
    if not AIMBOT_ENABLED then
        if MOUSE_LOCKED then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            MOUSE_LOCKED = false
        end
        PC_TARGET = nil
        return
    end
    
-- ============ AIMBOT PC ============
    if not isMobile then
        if not PC_TARGET or not PC_TARGET.Character then
            PC_TARGET = getClosestTargetPC()
        end
        
        if PC_TARGET and PC_TARGET.Character then
            local aimPart = PC_TARGET.Character:FindFirstChild("HumanoidRootPart") or PC_TARGET.Character:FindFirstChild("Torso")
            local hum = PC_TARGET.Character:FindFirstChildOfClass("Humanoid")
            
            if aimPart and hum and hum.Health > 0 and isVisible(PC_TARGET.Character) then
                local scr = camera:WorldToScreenPoint(aimPart.Position)
                local mousePos = UserInputService:GetMouseLocation()
                local smooth = SMOOTHNESS * 8
                if smooth < 1 then smooth = 1 end
                
                local deltaX = math.round((scr.X - mousePos.X) / smooth)
                local deltaY = math.round((scr.Y - 36 - mousePos.Y) / smooth)
                
                if type(mousemoverel) == "function" then
                    mousemoverel(deltaX, deltaY)
                end
            else
                PC_TARGET = nil
            end
        end
        return
    end
    
-- ============ AIMBOT MOBILE ============
    target = getClosestMobile()
    if target and target.Character then
        local hrp = target.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local camPos = camera.CFrame.Position
            local lookAtHRP = CFrame.new(camPos, hrp.Position)
            
            local fovScale = camera.FieldOfView / 70
            local angleOffset = AIM_ANGLE_OFFSET * fovScale
            
            local adjustedCFrame = lookAtHRP * CFrame.Angles(math.rad(-angleOffset), 0, 0)
            camera.CFrame = camera.CFrame:Lerp(adjustedCFrame, SMOOTHNESS)
            
            if not MOUSE_LOCKED then
                UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
                MOUSE_LOCKED = true
            end
        end
    else
        if MOUSE_LOCKED then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
            MOUSE_LOCKED = false
        end
    end
end)

-- ============ SKYBOX SYSTEM ============
function setSkybox(name)
    if currentSkybox then
        pcall(function()
            local lighting = game:GetService("Lighting")
            if lighting:FindFirstChild(currentSkybox) then
                lighting[currentSkybox]:Destroy()
            end
        end)
        currentSkybox = nil
    end
    
    if name == "None" then return end
    
    local data = skyboxes[name]
    if not data then return end
    
    local lighting = game:GetService("Lighting")
    local sky = Instance.new("Sky", lighting)
    sky.Name = name
    for prop, value in pairs(data) do
        sky[prop] = value
    end
    
    currentSkybox = name
end  

