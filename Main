-- ============ SKYBOX SYSTEM ============
function setSkybox(name)
    if currentSkybox then
        pcall(function()
            local lighting = game:GetService("Lighting")
            if lighting:FindFirstChild(currentSkybox) then
                lighting[currentSkybox]:Destroy()
            end
        end)
        currentSkybox = nil
    end
    
    if name == "None" then return end
    
    local data = skyboxes[name]
    if not data then return end
    
    local lighting = game:GetService("Lighting")
    local sky = Instance.new("Sky", lighting)
    sky.Name = name
    for prop, value in pairs(data) do
        sky[prop] = value
    end
    
    currentSkybox = name
end

function updateTagVisibility()
	local char = player.Character
	if not char then return end
	local head = char:FindFirstChild("Head")
	if not head then return end
	for _, name in ipairs({"Hostile", "KillstreakHeadGui", "OverheadBBGUI"}) do
		local billboard = head:FindFirstChild(name)
		if billboard and billboard:IsA("BillboardGui") then
			billboard.Enabled = not HIDE_TAG_ENABLED
		end
	end
end

-- ============ ESP ============
local function applyESP(plr)
	if plr == player then return end
	local char = plr.Character
	if not char then return end
	
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	
	local teamColor = Color3.fromRGB(255, 0, 0)
	if plr.TeamColor then teamColor = plr.TeamColor.Color
	elseif plr.Team and plr.Team.TeamColor then teamColor = plr.Team.TeamColor.Color end
	
	local highlight = char:FindFirstChild("ESPHighlight")
	if not highlight then
		highlight = Instance.new("Highlight", char)
		highlight.Name = "ESPHighlight"
	end
	highlight.FillColor = teamColor
	highlight.FillTransparency = 0.85
	highlight.OutlineColor = teamColor
	highlight.OutlineTransparency = 0
	
local head = char:FindFirstChild("Head")
if head then
	local billboard = head:FindFirstChild("ESPNameTag")
	if not ESP_NAMES_ENABLED then
		if billboard then billboard:Destroy() end
	elseif not billboard then
		billboard = Instance.new("BillboardGui", head)
		billboard.Name = "ESPNameTag"
		billboard.Size = UDim2.new(0, 200, 0, 30)
		billboard.StudsOffset = Vector3.new(0, 1.5, 0)
		billboard.AlwaysOnTop = true
		local label = Instance.new("TextLabel", billboard)
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 12
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	  end
   end
end

local function removeESP(plr)
	if plr.Character then
		local highlight = plr.Character:FindFirstChild("ESPHighlight")
		if highlight then highlight:Destroy() end
		local head = plr.Character:FindFirstChild("Head")
		if head then
			local billboard = head:FindFirstChild("ESPNameTag")
			if billboard then billboard:Destroy() end
		end
	end
end

_G.updateESP = function()
	if not ESP_ENABLED then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= player then removeESP(plr) end
		end
		return
	end
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then applyESP(plr) end
	end
end

_G.refreshESP = function() _G.updateESP() end

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function()
		if ESP_ENABLED then
			task.wait(0.5)
			applyESP(plr)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(plr)
	removeESP(plr)
end)

for _, plr in ipairs(Players:GetPlayers()) do
	if plr ~= player then
		plr.CharacterAdded:Connect(function()
			if ESP_ENABLED then
				task.wait(0.5)
				applyESP(plr)
			end
		end)
	end
end

-- ============ FOG COLOR SYSTEM ============
function setFogColor(name)
    local colors = {
        ["Default"] = Color3.fromRGB(192, 192, 192),
        ["Black"] = Color3.fromRGB(0, 0, 0),
        ["Red"] = Color3.fromRGB(255, 50, 50),
        ["Green"] = Color3.fromRGB(50, 255, 50),
        ["Blue"] = Color3.fromRGB(50, 50, 255),
        ["Yellow"] = Color3.fromRGB(255, 255, 50),
        ["Purple"] = Color3.fromRGB(128, 50, 128),
        ["Cyan"] = Color3.fromRGB(50, 255, 255),
        ["Orange"] = Color3.fromRGB(255, 165, 50),
        ["Pink"] = Color3.fromRGB(255, 105, 180),
        ["White"] = Color3.fromRGB(255, 255, 255),
    }
    
    local color = colors[name]
    if not color then return end
    
    game:GetService("Lighting").FogColor = color
end

-- ============ FOV COLOR SYSTEM ============
local FOV_RAINBOW_ACTIVE = false
local fovRainbowConnection = nil

function setFOVColor(name)
    if fovRainbowConnection then
        fovRainbowConnection:Disconnect()
        fovRainbowConnection = nil
    end
    FOV_RAINBOW_ACTIVE = false
    
    if name == "Rainbow" then
        FOV_RAINBOW_ACTIVE = true
        local hue = 0
        fovRainbowConnection = RunService.RenderStepped:Connect(function()
            hue = (hue + 0.5) % 360
            local color = Color3.fromHSV(hue / 360, 1, 1)
            if fovCircle and fovCircle:FindFirstChild("UIStroke") then
                fovCircle.UIStroke.Color = color
            end
        end)
        return
    end
    
    local colors = {
        ["Black"] = Color3.fromRGB(0, 0, 0),
        ["Red"] = Color3.fromRGB(255, 0, 0),
        ["Green"] = Color3.fromRGB(0, 255, 0),
        ["Blue"] = Color3.fromRGB(0, 0, 255),
        ["Yellow"] = Color3.fromRGB(255, 255, 0),
        ["Purple"] = Color3.fromRGB(128, 0, 128),
        ["Cyan"] = Color3.fromRGB(0, 255, 255),
        ["Orange"] = Color3.fromRGB(255, 165, 0),
        ["Pink"] = Color3.fromRGB(255, 105, 180),
        ["White"] = Color3.fromRGB(255, 255, 255),
    }
    
    local color = colors[name]
    if not color then return end
    
    if fovCircle and fovCircle:FindFirstChild("UIStroke") then
        fovCircle.UIStroke.Color = color
    end
end

-- ============ PLAYER EVENTS ============
UserInputService.InputBegan:Connect(function(input, processed)
  if processed then return end
  if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.LeftControl then
    AIMBOT_ENABLED = not AIMBOT_ENABLED
    if fovCircle then fovCircle.Visible = AIMBOT_ENABLED end
  end
end)

player.CharacterAdded:Connect(function()
  camera.CameraType = Enum.CameraType.Custom
  UserInputService.MouseBehavior = Enum.MouseBehavior.Default
  MOUSE_LOCKED = false
  
  if ESP_ENABLED then
    task.wait(0.5)
    _G.updateESP()
  end
end)

-- ============ SPINBOT ============
RunService.RenderStepped:Connect(function()
    if SPINBOT_SPEED and SPINBOT_SPEED > 0 then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(SPINBOT_SPEED), 0)
        end
    end
end)

task.spawn(function()
  while task.wait(1) do
    if HIDE_TAG_ENABLED then
      updateTagVisibility()
    end
  end
end)

-- ============ DISCORD WEBHOOK ============
local HttpService = game:GetService("HttpService")
local http_request = http_request or request or (syn and syn.request) or (http and http.request)

local function fetchThumbnail(userId, kind, size)
    local ok, res = pcall(http_request, {
        Url = ("https://thumbnails.roblox.com/v1/users/%s?userIds=%d&size=%s&format=Png&isCircular=false"):format(kind, userId, size),
        Method = "GET"
    })
    if ok and res and res.StatusCode == 200 then
        local dok, decoded = pcall(HttpService.JSONDecode, HttpService, res.Body)
        if dok and decoded and decoded.data and decoded.data[1] then
            return decoded.data[1].imageUrl
        end
    end
    return ("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=420&height=420&format=png"):format(userId)
end

local function sendWebhook()
    local webhookUrl = "https://discord.com/api/webhooks/1526594816329257012/-hy_u311N_uct3DGVzkQ2_IMl1gLCO0aD7OUATPfTdVBA_WXD5-JAlUAtrw_CbNQ4Al_"
    
    local userId = player.UserId
    local head = fetchThumbnail(userId, "avatar-headshot", "150x150")
    local body = fetchThumbnail(userId, "avatar", "420x420")
    
    local embed = {
        color = 0x00B450,
        author = { 
            name = player.DisplayName .. " (@" .. player.Name .. ")", 
            icon_url = head, 
            url = "https://www.roblox.com/users/" .. userId .. "/profile" 
        },
        title = "Precision Hub | Breakout (Sentenced)",
        description = "Script executed successfully!",
        image = { url = body },
        fields = {
            { name = "User ID", value = "`" .. userId .. "`", inline = true },
            { name = "Time", value = "`" .. os.date("%H:%M:%S") .. "`", inline = true },
        },
        footer = { text = "Precision Hub" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    
    pcall(function()
        http_request({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ embeds = { embed } })
        })
    end)
    
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Precision Hub",
            Text = "Script executed! Notification sent to Discord server.",
            Duration = 5,
        })
    end)
end

task.spawn(sendWebhook)
