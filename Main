-- Main Script Precision | Breakout (Sentenced)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
while not player do task.wait() player = Players.LocalPlayer end
local playerGui = player:WaitForChild("PlayerGui")
local camera = workspace.CurrentCamera

-- ============ SETTINGS ============
FOV_RADIUS = 100
SPINBOT_SPEED = 0
AIMBOT_ENABLED = true
HIDE_TAG_ENABLED = false
WANTED_ONLY = false
IGNORE_FRIENDS = true
ESP_ENABLED = false
ESP_NAMES_ENABLED = true
HIDE_FOV_CIRCLE = false
IGNORE_PRISONERS = false
IGNORE_GUARDS = false
IGNORE_ESCAPED = false
IGNORE_FORCEFIELD = true
TARGET_ON_PLAYER = nil

local target = nil
local currentSkybox = nil
local oldFireServer = nil
local SmoothedTargetPosition = nil

loadstring(game:HttpGet("https://raw.githubusercontent.com/maplez211/sentenced-breakout/refs/heads/main/UI"))()

-- ============ FOV CIRCLE ============
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FOVGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local fovCircle = Instance.new("Frame", screenGui)
fovCircle.Size = UDim2.new(0, FOV_RADIUS*2, 0, FOV_RADIUS*2)
fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
fovCircle.BackgroundColor3 = Color3.fromRGB(0,0,0)
fovCircle.BackgroundTransparency = 1
fovCircle.BorderSizePixel = 0
Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(1,0)
Instance.new("UIStroke", fovCircle).Color = Color3.fromRGB(0, 0, 0)
fovCircle.UIStroke.Thickness = 1
fovCircle.Visible = AIMBOT_ENABLED
_G.fovCircle = fovCircle

_G.toggleFOVCircle = function(hide)
    local stroke = fovCircle:FindFirstChild("UIStroke")
    if stroke then
        stroke.Enabled = not hide
    end
end

-- ============ MAIN FUNCTIONS ============
local function isVisible(targetCharacter)
    if not targetCharacter then return false end
    local hrp = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local origin = camera.CFrame.Position
    local direction = hrp.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {player.Character, targetCharacter}
    return Workspace:Raycast(origin, direction, params) == nil
end

local function isValidTarget(plr)
    if not plr or plr == player then return false end
    if not plr.Character then return false end
    
    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
    local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
    if not hum or hum.Health <= 0 or not hrp then return false end
    
    if IGNORE_FRIENDS and player:IsFriendsWith(plr.UserId) then return false end
    
    if player.Team and plr.Team == player.Team then return false end
    
    if plr.Team then
        local tn = plr.Team.Name
        if IGNORE_PRISONERS and tn == "Prisoners" then return false end
        if IGNORE_GUARDS and tn == "Guards" then return false end
        if IGNORE_ESCAPED and tn == "Escaped" then return false end
    end
    
    if IGNORE_FORCEFIELD then
        local ff = plr.Character:FindFirstChildOfClass("ForceField")
        if ff and ff.Visible then return false end
    end
    
    if WANTED_ONLY and plr.Team and plr.Team.Name == "Prisoners" then
        local head = plr.Character:FindFirstChild("Head")
        if head then
            local bb = head:FindFirstChild("OverheadBBGUI")
            local wanted = bb and bb:FindFirstChild("WantedTag")
            if not wanted or not wanted.Visible then return false end
        else
            return false
        end
    end
    
    if not isVisible(plr.Character) then return false end
    
    return true
end

local function getBestTarget()
    if TARGET_ON_PLAYER then
        local targetPlr = Players:FindFirstChild(TARGET_ON_PLAYER)
        if targetPlr and isValidTarget(targetPlr) then
            return targetPlr
        end
        return nil
    end
    
    local screenCenter = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    local mousePos = UserInputService:GetMouseLocation()
    local useMouse = (UserInputService.TouchEnabled == false) -- false em mobile = true em PC
    
    local closest = nil
    local shortestDistance = FOV_RADIUS
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local dist
                    if useMouse then
                        dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(mousePos.X, mousePos.Y)).Magnitude
                    else
                        dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    end
                    
                    if dist < shortestDistance then
                        closest = plr
                        shortestDistance = dist
                    end
                end
            end
        end
    end
    
    return closest
end

local function updateFOVPosition()
    if not fovCircle then return end
    fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    if UserInputService.TouchEnabled then
        fovCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
    else
        local mousePos = UserInputService:GetMouseLocation()
        fovCircle.Position = UDim2.new(0, mousePos.X - FOV_RADIUS, 0, mousePos.Y - FOV_RADIUS - 36)
    end
end

-- ============ SILENT AIM HOOK ============
local function getSpreadDirection(Origin, OriginalDirection, HitPart)
    local Distance = OriginalDirection.Magnitude
    if Distance == 0 then Distance = 1000 end
    
    local PartSize = HitPart.Size
    local RandomOffset = Vector3.new(
        (math.random() - 0.5) * PartSize.X,
        (math.random() - 0.5) * PartSize.Y,
        (math.random() - 0.5) * PartSize.Z
    )
    
    local BasePosition = SmoothedTargetPosition or HitPart.Position
    local TargetPosition = BasePosition + RandomOffset
    local NewDirection = (TargetPosition - Origin)
    
    return NewDirection.Unit * Distance
end

local function setupSilentAim()
    local char = player.Character
    if not char then return end
    
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end
    
    local rifleEvent = tool:FindFirstChild("RifleEvent")
    if not rifleEvent then return end
    
    if oldFireServer then return end
    
    oldFireServer = rifleEvent.FireServer
    
    rifleEvent.FireServer = function(self, action, aimPoint, rayOrigin, rayDirection, muzzlePos, hitInstance, hitPosition)
        if action == "Shoot" and AIMBOT_ENABLED and target and target.Character then
            local targetHRP = target.Character:FindFirstChild("HumanoidRootPart")
            local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
            
            if targetHRP and targetHum and targetHum.Health > 0 and isVisible(target.Character) then
                if not SmoothedTargetPosition then
                    SmoothedTargetPosition = targetHRP.Position
                else
                    SmoothedTargetPosition = SmoothedTargetPosition:Lerp(targetHRP.Position, 0.3)
                end
                
                local origin = rayOrigin or (char:FindFirstChild("Head") and char.Head.Position) or camera.CFrame.Position
                
                local newDirection = getSpreadDirection(origin, rayDirection, targetHRP)
                
                aimPoint = origin + newDirection
                rayDirection = newDirection
            else
                SmoothedTargetPosition = nil
                target = nil
            end
        else
            SmoothedTargetPosition = nil
        end
        
        return oldFireServer(self, action, aimPoint, rayOrigin, rayDirection, muzzlePos, hitInstance, hitPosition)
    end
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    SmoothedTargetPosition = nil
    oldFireServer = nil 
    setupSilentAim()
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") and child:FindFirstChild("RifleEvent") then
            task.wait(0.1)
            setupSilentAim()
        end
    end)
end)

-- ============ MAIN LOOP ============
RunService.RenderStepped:Connect(function()
    updateFOVPosition()
    
    if not AIMBOT_ENABLED then
        target = nil
        SmoothedTargetPosition = nil
        return
    end
    
    target = getBestTarget()
end)

-- ============ SPINBOT ============
RunService.RenderStepped:Connect(function()
    if SPINBOT_SPEED and SPINBOT_SPEED > 0 then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(SPINBOT_SPEED), 0)
        end
    end
end)

-- ============ KEYBINDS ============
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.E or input.KeyCode == Enum.KeyCode.LeftControl then
        AIMBOT_ENABLED = not AIMBOT_ENABLED
        if fovCircle then fovCircle.Visible = AIMBOT_ENABLED end
        if not AIMBOT_ENABLED then
            target = nil
            SmoothedTargetPosition = nil
        end
    end
end)

player.CharacterAdded:Connect(function()
    camera.CameraType = Enum.CameraType.Custom
    
    if ESP_ENABLED then
        task.wait(0.5)
        _G.updateESP()
    end
end)

